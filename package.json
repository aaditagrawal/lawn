{
  "name": "l2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:cloud": "concurrently -k -n web,convex -c blue,magenta \"vite dev --port 5296\" \"bunx convex dev\"",
    "dev:web": "vite dev --port 5296",
    "convex:local": "bash scripts/convex-local-setup.sh",
    "build": "vite build",
    "build:vercel": "bunx convex deploy --cmd 'bun run build' --cmd-url-env-var-name VITE_CONVEX_URL",
    "start": "vite preview --port 5296",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint app src convex --ignore-pattern 'convex/_generated/**'",
    "test": "bun run test:unit && bun run test:convex",
    "test:unit": "bun test",
    "test:convex": "vitest run",
    "check": "bun run format:check && bun run typecheck && bun run typecheck:convex && bun run lint && bun run test",
    "typecheck": "tsc --noEmit",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "generate:og": "bun run scripts/generate-og.tsx",
    "test:player": "playwright test"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@clerk/tanstack-react-start": "^1.7.8",
    "@convex-dev/presence": "^0.4.0",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@convex-dev/stripe": "^0.1.7",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@mux/mux-node": "^15.5.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.48.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sharp": "^0.32.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "convex-test": "^0.0.66",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "overrides": {
    "fflate": "^0.7.5"
  }
}
